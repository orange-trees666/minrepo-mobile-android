<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="MinRepoMobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#17365D</Color>
            <Color x:Key="Accent">#2F75B5</Color>
            <Color x:Key="Surface">#F6F8FB</Color>
            <Color x:Key="Border">#D5DEE8</Color>
            <Color x:Key="TextPrimary">#17212B</Color>
            <Color x:Key="TextSecondary">#5C6975</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="#8B98A5" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
