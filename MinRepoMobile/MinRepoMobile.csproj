<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pixel 7aでの単体実行を目的とし、Androidだけを対象にすることで構成を簡潔にします。 -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinRepoMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 文字列補間・raw文字列・コレクション式をSDK付属の最新C#で統一します。 -->
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>みんレポ抽出</ApplicationTitle>
    <ApplicationId>jp.minrepo.mobileextractor</ApplicationId>
    <!-- 更新判定用の版番号。上書きインストールには別途同一の署名鍵が必要です。 -->
    <ApplicationDisplayVersion>1.0.19</ApplicationDisplayVersion>
    <ApplicationVersion>20</ApplicationVersion>

    <!-- Android 8.0以上。Pixel 7aはこの条件を満たします。 -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- 個人端末への直接インストールに使いやすいAPKを生成します。 -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- DebugのFast Deploymentへ依存せず、ADBなしの単体導入にも必要な実行コードを同梱します。 -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

